# Copy to .env and fill in the two app passwords. .env is gitignored; this file is not.
#
# Each password must be generated while signed in as THAT account at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on first).
# Google shows them as four groups of four; the spaces are stripped on load.
#
# An app password is not read-only. It grants full IMAP access, so treat this
# like a password file. Revoke one at the URL above without affecting the other.

GMAIL_MAIN_USER=you@gmail.com
GMAIL_MAIN_APP_PASSWORD=

GMAIL_SCOUT_USER=scout@gmail.com
GMAIL_SCOUT_APP_PASSWORD=
